<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:fillViewport="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Back Arrow -->

        <TextView
            android:id="@+id/btnProfileBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#002147"
            android:textSize="34sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />


        <!-- Page Title -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="My Profile"
            android:textColor="#002147"
            android:textSize="25sp"
            android:textStyle="bold" />


        <!-- Subtitle -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="View your profile information"
            android:textColor="#777777"
            android:textSize="13sp" />


        <!-- Profile Avatar -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="14dp">

            <FrameLayout
                android:layout_width="105dp"
                android:layout_height="105dp">

                <ImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="105dp"
                    android:layout_height="105dp"
                    android:background="@drawable/bg_profile_avatar"
                    android:contentDescription="Profile picture"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_profile_person" />

                <TextView
                    android:id="@+id/btnCamera"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_camera_circle"
                    android:gravity="center"
                    android:text="📷"
                    android:textSize="14sp" />

            </FrameLayout>


            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Student Name"
                android:textColor="#002147"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ========================================== -->
        <!-- EXTRA FEATURES -->
        <!-- ========================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Internship Preparation"
            android:textColor="#002147"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Interview Preparation -->

        <Button
            android:id="@+id/btnInterview"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#ED1C24"
            android:text="🎤  Interview Preparation"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Timeline -->

        <Button
            android:id="@+id/btnTimeline"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#002147"
            android:text="📅  Internship Timeline"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- FAQ -->

        <Button
            android:id="@+id/btnFaq"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#ED1C24"
            android:text="❓  Frequently Asked Questions"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />




        <!-- Profile Information Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/bg_profile_card">

            <!-- Full Name -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:textColor="#777777"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvProfileFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Student Name"
                    android:textColor="#002147"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Student ID -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Student ID"
                    android:textColor="#777777"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvProfileStudentId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="AM261XXXXXX"
                    android:textColor="#002147"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Email -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textColor="#777777"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="student@example.com"
                    android:textColor="#002147"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Account Type -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Account Type"
                    android:textColor="#777777"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvProfileRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Student"
                    android:textColor="#002147"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- Edit Profile -->

        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#ED1C24"
            android:text="✎  Edit Profile"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />


        <!-- LOGOUT -->

        <Button
            android:id="@+id/btnProfileLogout"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#002147"
            android:text="↪  Logout"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />


        <!-- Back Button -->

        <Button
            android:id="@+id/btnProfileBottomBack"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_profile_back"
            android:text="‹  Back"
            android:textAllCaps="false"
            android:textColor="#002147"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>