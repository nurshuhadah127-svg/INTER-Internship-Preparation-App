<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="25dp">

        <!-- TOP BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:text="‹"
                android:textColor="#002147"
                android:textSize="34sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>


        <!-- TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Interview Preparation"
            android:textColor="#002147"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prepare yourself for internship interviews"
            android:textColor="#777777"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp" />


        <!-- ================= INTERVIEW TIPS ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="15dp"
            android:background="@drawable/bg_content_card">

            <LinearLayout
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_icon_box"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★"
                    android:textColor="#ED1C24"
                    android:textSize="27sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Interview Tips"
                    android:textColor="#002147"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Learn how to answer common interview questions and present yourself professionally."
                    android:textColor="#777777"
                    android:textSize="10sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="5dp" />

                <Button
                    android:id="@+id/btnInterviewTips"
                    android:layout_width="130dp"
                    android:layout_height="40dp"
                    android:text="View Tips  →"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_purple_button"
                    android:layout_marginTop="9dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================= COMMON QUESTIONS ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="15dp"
            android:background="@drawable/bg_content_card"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_icon_box"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="?"
                    android:textColor="#ED1C24"
                    android:textSize="29sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Common Questions"
                    android:textColor="#002147"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Practice common questions asked during internship interviews."
                    android:textColor="#777777"
                    android:textSize="10sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="5dp" />

                <Button
                    android:id="@+id/btnCommonQuestions"
                    android:layout_width="145dp"
                    android:layout_height="40dp"
                    android:text="View Questions  →"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_purple_button"
                    android:layout_marginTop="9dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================= INTERVIEW CHECKLIST ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Interview Checklist"
            android:textColor="#002147"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_resource_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="✓  Research the company"
                android:textColor="#002147"
                android:textSize="12sp"
                android:gravity="center_vertical"
                android:paddingStart="14dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D9E1EA" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="✓  Prepare your introduction"
                android:textColor="#002147"
                android:textSize="12sp"
                android:gravity="center_vertical"
                android:paddingStart="14dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D9E1EA" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="✓  Prepare suitable questions"
                android:textColor="#002147"
                android:textSize="12sp"
                android:gravity="center_vertical"
                android:paddingStart="14dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D9E1EA" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="✓  Dress appropriately"
                android:textColor="#002147"
                android:textSize="12sp"
                android:gravity="center_vertical"
                android:paddingStart="14dp" />

        </LinearLayout>


        <!-- ================= TIP ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tip"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:text="💡"
                android:textSize="25sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Interview Tip"
                    android:textColor="#ED1C24"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stay calm, speak clearly and be confident when answering questions."
                    android:textColor="#555555"
                    android:textSize="10sp"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>