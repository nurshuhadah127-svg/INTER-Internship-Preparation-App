<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA">


    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">


        <TextView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="‹"
            android:textSize="35sp"
            android:textColor="#002147"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">


            <TextView
                android:id="@+id/tvCategoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="General Information"
                android:textColor="#002147"
                android:textSize="23sp"
                android:textStyle="bold"/>


            <TextView
                android:id="@+id/tvCategorySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Industrial training documents"
                android:textColor="#777777"
                android:textSize="12sp"
                android:layout_marginTop="3dp"/>

        </LinearLayout>

    </LinearLayout>


    <!-- SEARCH -->

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="15dp"
        android:background="@drawable/bg_document_search"
        android:hint="Search documents..."
        android:textSize="14sp"
        android:singleLine="true"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"/>


    <!-- DOCUMENT LIST -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">


        <LinearLayout
            android:id="@+id/documentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingBottom="25dp"/>

    </ScrollView>


</LinearLayout>